<?xml version="1.0"?>
<package format="3">
  <name>robotino_description</name>
  <version>0.1.0</version>
  <description>The robotino_description package</description>
  <maintainer email="verbeek@servicerobotics.eu">Christian Verbeek</maintainer>
  <license>BSD</license>
  <url type="website">http://wiki.ros.org/robotino_description</url>
  <author email="v@rec.de">Christian Verbeek</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>xacro</buildtool_depend>

  <depend>realsense2_description</depend>

  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
